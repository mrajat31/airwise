# Copy to .env.local for local development. Never commit real values.
# Everything here is optional; the app works without any of it.

# Privacy-friendly analytics (Plausible-compatible). Leave empty to disable analytics and the PMF survey.
VITE_PLAUSIBLE_DOMAIN=
# Only needed when self-hosting Plausible.
VITE_PLAUSIBLE_HOST=

# Station data is fetched by `npm run stations`, which reads OPENAQ_API_KEY from your shell
# environment (not from this file), e.g. `OPENAQ_API_KEY=... npm run stations`.
# It must never be prefixed with VITE_: Vite would then put it in the browser bundle.
